deployment "my-api" {
  namespace = "my-app"

  container "api" {
    image       = image("my-api")
    working_dir = "/app"

    env {
      APP_ENV = var.environment
    }

    port "8080" "http" {
      health = "/health"
    }
  }

  container "nginx" {
    image = image("nginx")

    port "80" "http" {
      tcp_health = true
    }
  }

  service {
    port "80" "http" {}
  }
}

deployment "my-cdn" {
  namespace = "my-app"

  container "cdn" {
    image = image("my-cdn")

    port "3000" "http" {
      health = "/health"
    }
  }

  service {
    port "3000" "http" {}
  }
}
