sealedsecret "db-credentials" {
  namespace = "acme-app"

  data = {
    DATABASE_URL = "AgBy3i4OJSWK+PiTySYZZA9rO43cGDEq..."
    PASSWORD     = "AgCE9F2h7GKJF8mL3nP5rS7tV9xB2dH4..."
  }
}

sealedsecret "jwt-keys" {
  namespace = "acme-app"
  type      = "Opaque"

  data = {
    SECRET = "AgDK4m6NQPRS8uW0yA2cE4gI6kM8oQ0s..."
  }
}

deployment "acme-api" {
  namespace = "acme-app"

  container "api" {
    image = "registry.example.com/acme/api:${var.image_tag}"

    env {
      APP_ENV      = var.environment
      DATABASE_URL = secret("db-credentials", "DATABASE_URL")
      JWT_SECRET   = secret("jwt-keys", "SECRET")
    }

    port "8080" "http" {
      health = "/health"
    }
  }

  service {
    port "8080" "http" {}
  }
}
