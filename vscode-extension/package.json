{
  "name": "kdef",
  "displayName": "kdef - Kubernetes Declarative Configuration",
  "description": "Syntax highlighting, snippets, and language support for .kdef files",
  "version": "0.4.0",
  "publisher": "gsid",
  "author": {
    "name": "Guido Smit",
    "email": "guido@gsid.nl",
    "url": "https://gsid.nl"
  },
  "license": "Apache-2.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "kubernetes",
    "k8s",
    "kdef",
    "hcl",
    "devops",
    "infrastructure"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gsid-nl/kdef"
  },
  "contributes": {
    "languages": [
      {
        "id": "kdef",
        "aliases": [
          "kdef",
          "Kdef"
        ],
        "extensions": [
          ".kdef"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kdef",
        "scopeName": "source.kdef",
        "path": "./syntaxes/kdef.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kdef",
        "path": "./snippets/kdef.json"
      }
    ]
  }
}
